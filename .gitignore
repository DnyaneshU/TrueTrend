# Real reports and patient data never go into the repo:
# the database (and SQLite's -journal/-wal/-shm side files), report PDFs and photos.
storage/
*.db
*.db-*
*.sqlite
*.sqlite3
*.pdf
*.part
*.jpg
*.jpeg
*.png
*.heic
*.webp
# ...except synthetic sample reports, the web app's own pictures, and the project
# page's screenshots, which show the app reading those same invented reports.
!samples/**
!arogya_vahi/web/**
!docs/shots/**

# Python and tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
# build artifacts
*.egg-info/
build/
dist/

# Secrets and local settings
.env
.env.*

# Editors
.idea/
.vscode/

# The submission: the DEV post and the demo notes are written for the challenge,
# not part of the app, and the tunnel binary is a 50 MB download, not source.
submission/
*.exe

# Development notes and AI-assistant working files: kept locally, not part of the app
CLAUDE.md
docs/superpowers/
.superpowers/
