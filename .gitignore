# Real reports and patient data never go into the repo:
# the database (and SQLite's -journal/-wal/-shm side files), report PDFs and photos.
storage/
*.db
*.db-*
*.sqlite
*.sqlite3
*.pdf
*.part
*.jpg
*.jpeg
*.png
*.heic
*.webp
# ...except synthetic sample reports and the web app's icons, once they exist
!samples/**
!web/icons/**

# Python and tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
# build artifacts
*.egg-info/
build/
dist/

# Secrets and local settings
.env
.env.*

# Editors
.idea/
.vscode/

# Development notes and AI-assistant working files: kept locally, not part of the app
CLAUDE.md
docs/superpowers/
.superpowers/
