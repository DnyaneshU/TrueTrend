# Real reports and patient data never go into the repo:
# the database (and SQLite's -journal/-wal/-shm side files), report PDFs and photos.
storage/
*.db
*.db-*
*.sqlite
*.sqlite3
*.pdf
*.jpg
*.jpeg
*.png
*.heic
*.webp
/out*.json
# ...except synthetic sample reports and the web app's icons
!samples/**
!web/icons/**

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
# build artifacts from `pip install -e .`
*.egg-info/
build/
dist/

# Secrets
.env

# Development notes and AI-assistant working files: kept locally, not part of the app
CLAUDE.md
docs/superpowers/
.superpowers/
